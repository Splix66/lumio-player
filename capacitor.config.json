{
  "appId": "de.lumio.player",
  "appName": "Lumio Player",
  "webDir": "www",
  "backgroundColor": "#0b0a1a",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b0a1a"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
