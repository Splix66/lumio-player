{
  "name": "lumio-player-desktop",
  "version": "1.0.0",
  "description": "Telvo Player für Windows und Mac",
  "author": "Telvo",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bauen": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.lumio.player",
    "productName": "Telvo Player",
    "files": ["main.js", "app/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "lumio-player-setup.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "icon.png",
      "category": "public.app-category.entertainment",
      "identity": null
    },
    "dmg": {
      "artifactName": "lumio-player-mac.${ext}"
    }
  }
}
