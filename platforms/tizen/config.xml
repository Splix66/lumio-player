<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://lumio.player/tv" version="1.0.0" viewmodes="maximized">
  <tizen:application id="LumioPlay0.LumioPlayer" package="LumioPlay0" required_version="3.0"/>
